# Leave empty for a durable local SQLite database at data/secquest.sqlite.
DATABASE_URL=
# Docker Compose requires a URL-safe random database password (letters/digits).
POSTGRES_PASSWORD=
APP_ORIGIN=http://localhost:3000
# Set true behind an HTTPS reverse proxy in deployment.
COOKIE_SECURE=false
# Optional SMTP for password recovery (otherwise reset delivery is disabled).
SMTP_URL=
MAIL_FROM=SecQuest <noreply@example.com>
